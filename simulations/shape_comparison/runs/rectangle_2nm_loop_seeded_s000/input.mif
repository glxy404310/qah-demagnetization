# MIF 2.2
SetOptions { basename result scalar_output_format %.17g vector_field_output_format {binary 8} }
Specify Oxs_BoxAtlas:atlas {
 name film
 xrange {-2.0000000000000002e-07 2.0000000000000002e-07}
 yrange {-5.0000000000000004e-08 5.0000000000000004e-08}
 zrange {0 4e-9}
}
Specify Oxs_RectangularMesh:mesh { cellsize {2e-09 2e-09 2e-09} atlas :atlas }
Specify Oxs_Demag:demag {}
Specify Oxs_UniformExchange:exchange { A 5e-12 }
Specify Oxs_UniaxialAnisotropy:anisotropy { K1 80000.0 axis {0 0 1} }
Specify Oxs_UZeeman:zeeman {
 multiplier 795774.71545947669
 Hrange { {0 0 0.59999999999999998 0 0 0.59999999999999998 0}
{0 0 0.57999999999999996 0 0 0.57999999999999996 0}
{0 0 0.56000000000000005 0 0 0.56000000000000005 0}
{0 0 0.54000000000000004 0 0 0.54000000000000004 0}
{0 0 0.52000000000000002 0 0 0.52000000000000002 0}
{0 0 0.5 0 0 0.5 0}
{0 0 0.47999999999999998 0 0 0.47999999999999998 0}
{0 0 0.46000000000000002 0 0 0.46000000000000002 0}
{0 0 0.44 0 0 0.44 0}
{0 0 0.41999999999999998 0 0 0.41999999999999998 0}
{0 0 0.40000000000000002 0 0 0.40000000000000002 0}
{0 0 0.38 0 0 0.38 0}
{0 0 0.35999999999999999 0 0 0.35999999999999999 0}
{0 0 0.34000000000000002 0 0 0.34000000000000002 0}
{0 0 0.32000000000000001 0 0 0.32000000000000001 0}
{0 0 0.29999999999999999 0 0 0.29999999999999999 0}
{0 0 0.28000000000000003 0 0 0.28000000000000003 0}
{0 0 0.26000000000000001 0 0 0.26000000000000001 0}
{0 0 0.23999999999999999 0 0 0.23999999999999999 0}
{0 0 0.22 0 0 0.22 0}
{0 0 0.20000000000000001 0 0 0.20000000000000001 0}
{0 0 0.17999999999999999 0 0 0.17999999999999999 0}
{0 0 0.16 0 0 0.16 0}
{0 0 0.14000000000000001 0 0 0.14000000000000001 0}
{0 0 0.12 0 0 0.12 0}
{0 0 0.10000000000000001 0 0 0.10000000000000001 0}
{0 0 0.080000000000000002 0 0 0.080000000000000002 0}
{0 0 0.059999999999999998 0 0 0.059999999999999998 0}
{0 0 0.040000000000000001 0 0 0.040000000000000001 0}
{0 0 0.02 0 0 0.02 0}
{0 0 0 0 0 0 0} }
}
Specify Oxs_RungeKuttaEvolve:evolve {
 alpha 0.5 gamma_G 2.21e5 do_precess 0 method rkf54 relative_step_error 1e-7
 
}
Specify Oxs_TimeDriver {
 evolver :evolve mesh :mesh
 Ms { Oxs_AtlasScalarField { atlas :atlas default_value 0 values {film 300000.0} } }
 m0 { Oxs_FileVectorField { file initial.omf spatial_scaling {1 1 1} spatial_offset {0 0 0} norm 1 } }
 stopping_dm_dt 0.01
 stage_iteration_limit 100000
 total_iteration_limit 3100000
 stage_count 31
 checkpoint_interval -1
 normalize_aveM_output 1
}
Destination archive mmArchive
Schedule DataTable archive Step 100
Schedule DataTable archive Stage 1
Schedule DataTable archive Done
Schedule Oxs_TimeDriver::Spin archive Stage 1
Schedule Oxs_Demag:demag:Field archive Stage 1
Schedule {Oxs_RungeKuttaEvolve:evolve:Total field} archive Stage 1
