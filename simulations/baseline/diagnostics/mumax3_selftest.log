TableAdd(E_demag)
TableAdd(E_exch)
TableAdd(E_anis)
TableAdd(E_Zeeman)
TableAdd(E_total)
TableAdd(maxTorque)
TableAdd(B_ext)
TableAddVar(step, "steps", "")
m = Uniform(1, 0, 0)
TableSave()
